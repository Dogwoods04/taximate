# Backend (Spring) — export these or put them in your shell / run config. Never commit real keys.
DB_URL=jdbc:postgresql://localhost:5432/taximate
DB_USERNAME=taximate
DB_PASSWORD=taximate
# Kakao REST API key (Local search + Mobility Directions). Empty => mock adapters.
KAKAO_REST_API_KEY=
# Kakao Login: enabled when REST key exists; override false to disable.
# KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URIS=http://localhost:5173/auth/kakao,http://127.0.0.1:5173/auth/kakao
# KAKAO_AUTH_BASE_URL=https://kauth.kakao.com
# KAKAO_API_BASE_URL=https://kapi.kakao.com
DEV_LOGIN_ENABLED=true
ADMIN_NICKNAMES=admin
# Demo-only nickname login: when set, nickname login accepts only nicknames starting with this (plus ADMIN_NICKNAMES);
# empty = any nickname. backend/.env is a properties file: write Korean as unicode escapes, e.g. 샘플 -> 샘플
DEV_LOGIN_NICKNAME_PREFIX=
# mock | kakao
KAKAO_MODE=mock
# TMAP pedestrian route app key (openapi.sk.com). Empty => walking distance is a straight-line estimate.
TMAP_APP_KEY=
# UX testing only: rooms whose host nickname starts with this keep rolling forward (empty = off)
DEMO_KEEPALIVE_PREFIX=
# local | redis  (local = in-JVM lock, single instance only)
LOCK_MODE=local
REDIS_URL=redis://localhost:6379

# Frontend (Vite) — put in frontend/.env.local
# VITE_API_MODE=mock | http
# VITE_API_BASE_URL=http://localhost:8080
# VITE_KAKAO_JS_KEY=
